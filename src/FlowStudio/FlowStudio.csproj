<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FlowStudio</AssemblyName>
    <RootNamespace>FlowStudio</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <Description>Independent native creative studio for Windows</Description>
  </PropertyGroup>
  <ItemGroup><Resource Include="app.ico" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Resources/update-public.pem" LogicalName="FlowStudio.update-public.pem" /></ItemGroup>
</Project>
