          </StackPanel></Grid></Border>
        </Grid>
        <Border Grid.Row="2" Background="#151A1C" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"><Grid Margin="25,12,25,9"><Grid.RowDefinitions><RowDefinition Height="31"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="РАСКАДРОВКА" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="ShotCount" Text="0 сцен" FontSize="10" Foreground="{StaticResource Muted}" Margin="13,0"/><TextBlock Text="Соберите свою историю по кадрам" FontSize="10" Foreground="#5F6D70"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="←" Click="MoveLeft_Click" Padding="9,3" ToolTip="Сдвинуть сцену влево"/><Button Content="→" Click="MoveRight_Click" Padding="9,3" Margin="5,0" ToolTip="Сдвинуть сцену вправо"/><Button Content="Убрать" Click="RemoveShot_Click" Padding="9,3" FontSize="10"/></StackPanel></Grid><ListBox x:Name="StoryboardList" Grid.Row="1" ItemTemplate="{StaticResource ShotTemplate}" SelectionChanged="Shot_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox><Border x:Name="EmptyStoryboard" Grid.Row="1" BorderBrush="#35413D" BorderThickness="1" CornerRadius="8" Margin="0,9,0,3"><TextBlock Text="＋   Выберите материал в медиатеке и нажмите «В сцену»" HorizontalAlignment="Center" Foreground="#6E8177" FontSize="12"/></Border></Grid></Border>
        <Border x:Name="SettingsPage" Grid.RowSpan="3" Visibility="Collapsed" Background="{StaticResource Bg}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="34,25" MaxWidth="850" HorizontalAlignment="Left"><TextBlock Text="Подключение и производительность" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Ваш Flow. Ваши проекты. Нативное рабочее пространство." Foreground="{StaticResource Muted}" Margin="0,9,0,23"/>
          <Border Background="#1C2420" BorderBrush="#3A4932" BorderThickness="1" CornerRadius="11" Padding="20"><StackPanel><TextBlock Text="Google Flow · ваш аккаунт" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Войдите в Google в отдельном профиле Chrome или Edge. Каталог, баланс и медиатека загружаются нативно. Способ отправки генераций и сообщений агенту выбирается ниже." Foreground="#B3C1AA" Margin="0,10,0,0"/><TextBlock Text="Используются только аккаунт и кредиты Flow. Служебный браузер работает на время операции. При ручном входе или проверке Google потребуется ваше участие." Foreground="#AFAF94" FontSize="12" Margin="0,12,0,0"/>
          <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button x:Name="LoginGoogleButton" Content="Войти через Google" Style="{StaticResource AccentButton}" Click="LoginGoogle_Click"/><Button x:Name="ProbeButton" Content="Обновить аккаунт" Click="ProbeFlow_Click" Margin="10,0,0,0"/><Button Content="Отключить аккаунт" Click="ForgetToken_Click" Margin="10,0,0,0"/></StackPanel><TextBlock x:Name="CreditBalanceText" Text="Кредиты Flow: —" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,18,0,0"/></StackPanel></Border>
          <CheckBox x:Name="RememberToken" Content="Сохранять вход на этом компьютере (шифрование Windows DPAPI)" IsChecked="True"/>
          <TextBlock x:Name="FlowProbeText" Text="Вход не выполнен" Foreground="#ADB7A4" Margin="0,8,0,0"/>
          <Button x:Name="ContinueLoginButton" Content="Я вошёл — продолжить" Visibility="Collapsed" Click="ContinueLogin_Click" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
