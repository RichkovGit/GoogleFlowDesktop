            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Последний кадр" Click="LastFrame_Click" FontSize="10" Padding="8,6"/><Button Content="Сбросить" Click="ClearReferences_Click" FontSize="10" Padding="8,6" Background="Transparent" Margin="8,0,0,0"/></StackPanel>
