            <TextBlock Text="ВАША ИДЕЯ" FontSize="9" Foreground="#9EA8A7" Margin="0,19,0,9"/>
            <TextBox x:Name="PromptBox" AcceptsReturn="True" MinHeight="145" MaxHeight="230" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="Prompt_Changed" ToolTip="Опишите сцену, действие, движение камеры и свет"/>
            <TextBlock Text="Сцена, движение камеры, свет, атмосфера…" FontSize="10" Foreground="#687778" Margin="1,7,0,0"/>
            <TextBlock Text="МОДЕЛЬ FLOW" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,18,0,7"/><ComboBox x:Name="ComposerModelBox" SelectionChanged="ComposerModel_Changed" ToolTip="Получите актуальные модели Flow в настройках аккаунта"><ComboBox.ItemTemplate><DataTemplate><StackPanel MaxWidth="240"><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding DisplayName}" Visibility="Collapsed" FontSize="8" Foreground="#9EAF98" Margin="0,2,0,0" TextWrapping="Wrap"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
            <Grid Margin="0,19,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ФОРМАТ" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/><ComboBox x:Name="AspectBox" SelectedIndex="0" SelectionChanged="Composition_Changed"><ComboBoxItem Content="16:9"/><ComboBoxItem Content="9:16"/><ComboBoxItem Content="1:1"/><ComboBoxItem Content="4:3"/><ComboBoxItem Content="3:4"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="ДЛИТЕЛЬНОСТЬ / КАЧЕСТВО" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/><ComboBox x:Name="DurationBox" SelectionChanged="Variant_Changed" SelectedIndex="0" IsEnabled="False" ToolTip="Длительность определяет выбранная модель Flow"><ComboBoxItem Content="По модели" Tag="8"/></ComboBox></StackPanel></Grid>
            <TextBlock Text="РЕФЕРЕНСЫ" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,20,0,8"/>
