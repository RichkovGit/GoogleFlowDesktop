      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0"><TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" FontSize="9" Foreground="{StaticResource Muted}"/><TextBlock Text=" / " Foreground="#4D5558" Margin="10,0"/><TextBlock x:Name="ProjectHeader" Text="Новый проект" FontWeight="SemiBold"/><TextBlock x:Name="SavedMark" Text="  ·  сохранено" FontSize="10" Foreground="#7D916E"/></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="—" Background="Transparent" Click="Minimize_Click" Width="45" ToolTip="Свернуть"/><Button Content="□" Background="Transparent" Click="Maximize_Click" Width="45" ToolTip="Развернуть"/><Button Content="✕" Background="Transparent" Click="Close_Click" Width="49" ToolTip="Закрыть"/></StackPanel>
    </Grid>
