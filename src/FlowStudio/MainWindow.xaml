          </Grid>
          <Border Grid.Column="2" Background="#191D20" BorderBrush="#30373A" BorderThickness="1" CornerRadius="13" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
